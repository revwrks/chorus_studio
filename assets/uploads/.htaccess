Options -Indexes

# Block execution or access to script files and dotfiles in uploads
<FilesMatch "(?i)(^\.htaccess$|\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP execution if running under mod_php
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
