# Disable directory listing
Options -Indexes

# Prevent InfinityFree external error redirect
ErrorDocument 400 default
ErrorDocument 401 default
ErrorDocument 403 default
ErrorDocument 404 default
ErrorDocument 500 default

# Protect hidden files, configs, docs, backups, and SQL files
<FilesMatch "(?i)(^\.|^config\.php$|^config\.example\.php$|^README\.md$|.*\.(sql|sql\.gz|bak|log|md|tmp)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct HTTP access to internal directories (works at domain root or subdirectory)
<IfModule mod_alias.c>
    RedirectMatch 403 (?i)/(src|views|includes|setup|tests|tmp)(/|$)
</IfModule>

# Compress output for faster loading on shared hosting
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching for static assets (InfinityFree optimization)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
